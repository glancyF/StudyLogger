<idea-plugin>
    <id>valentyn.deshel.studylogger</id>
    <name>Study Integrity Logger</name>
    <vendor email="valentindesel@gmail.com">Valentyn</vendor>

    <description><![CDATA[
        Local study integrity logger. Records IDE file activity metadata into .study-log/file-events.log.
        The plugin does not store source code and does not send data anywhere.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <projectListeners>
        <listener
                class="deshel.valentyn.studylogger.listener.StudyFileEditorListener"
                topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
        <listener
                class="deshel.valentyn.studylogger.listener.StudyProjectActivityListener"
                topic="com.intellij.openapi.project.ProjectManagerListener"/>
    </projectListeners>

    <applicationListeners>
        <listener
                class="deshel.valentyn.studylogger.listener.StudyFileSaveListener"
                topic="com.intellij.openapi.fileEditor.FileDocumentManagerListener"/>
    </applicationListeners>
    <actions>
        <group id="StudyIntegrityLogger.Group"
               text="Study Integrity Logger"
               popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <action id="StudyIntegrityLogger.VerifyLog"
                    class="deshel.valentyn.studylogger.action.VerifyStudyLogAction"
                    text="Verify Log"
                    description="Verify study integrity logger hash chain"/>
        </group>
    </actions>
</idea-plugin>