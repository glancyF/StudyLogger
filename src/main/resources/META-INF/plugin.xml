<idea-plugin>
    <id>valentyn.deshel.studylogger</id>
    <name>Study Integrity Logger</name>
    <vendor email="valentindesel@gmail.com">Valentyn</vendor>

    <description><![CDATA[
        Local study integrity logger. Records IDE file activity metadata into .study-log/file-events.log.
        The plugin does not store source code and does not send data anywhere.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <projectListeners>
        <listener
                class="deshel.valentyn.studylogger.logic.listener.StudyFileEditorListener"
                topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
        <listener
                class="deshel.valentyn.studylogger.logic.listener.StudyProjectActivityListener"
                topic="com.intellij.openapi.project.ProjectManagerListener"/>
    </projectListeners>

    <applicationListeners>
        <listener
                class="deshel.valentyn.studylogger.logic.listener.StudyFileSaveListener"
                topic="com.intellij.openapi.fileEditor.FileDocumentManagerListener"/>
    </applicationListeners>
    <actions>
        <group id="StudyIntegrityLogger.Group"
               text="Study Integrity Logger"
               popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <action id="StudyIntegrityLogger.VerifyLog"
                    class="deshel.valentyn.studylogger.ui.action.VerifyStudyLogAction"
                    text="Verify Log"
                    description="Verify study integrity logger hash chain"/>
            <action id="StudyIntegrityLogger.GenerateFinalReport"
                    class="deshel.valentyn.studylogger.ui.action.GenerateFinalReportAction"
                    text="Generate Final Report"
                    description="Generate final study integrity evidence report"/>
            <action id="StudyIntegrityLogger.Toggle"
                    class="deshel.valentyn.studylogger.ui.action.ToggleStudyLoggerAction"
                    text="Turn Study Logger OFF"
                    description="Enable or disable study integrity logger"/>
            <action id="StudyIntegrityLogger.GenerateSubmissionEvidence"
                    class="deshel.valentyn.studylogger.ui.action.GenerateSubmissionEvidenceAction"
                    text="Generate Submission Evidence"
                    description="Generate SHA-256 evidence for a selected submission file"/>
            <action id="StudyIntegrityLogger.ExportEvidencePackage"
                    class="deshel.valentyn.studylogger.ui.action.ExportEvidencePackageAction"
                    text="Export Evidence Package"
                    description="Export study integrity evidence files as a ZIP archive"/>
        </group>
    </actions>
    <extensions defaultExtensionNs="com.intellij">
        <statusBarWidgetFactory implementation="deshel.valentyn.studylogger.ui.widget.StudyLoggerStatusBarWidgetFactory"/>
    </extensions>
</idea-plugin>